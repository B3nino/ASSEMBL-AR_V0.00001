<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/toolbar_height">

    <dev.chyken.assembl_ar.ui.MaxWidthLinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center_horizontal"
        android:gravity="center_vertical"
        android:maxWidth="@dimen/content_max_width"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:padding="14dp"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:id="@+id/toolbarTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/ink"
            android:textSize="22sp"
            android:textStyle="bold" />
    <ImageButton android:id="@+id/btnTtsMuteToggle" android:layout_width="48dp" android:layout_height="48dp" android:visibility="gone" android:padding="12dp" android:background="@drawable/bg_circle_dark" android:src="@drawable/ic_volume_up" android:contentDescription="@string/narration_mute" />
    </dev.chyken.assembl_ar.ui.MaxWidthLinearLayout>
</FrameLayout>
