<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.ASSEMBLAR.Eyebrow" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">@color/primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="TextAppearance.ASSEMBLAR.Title" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.ASSEMBLAR.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/ink_soft</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="Widget.ASSEMBLAR.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">54dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.ASSEMBLAR.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="strokeColor">@color/control_outline</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- A text action inside the assembly Details area, sized as a full-width touch target. -->
    <style name="Widget.ASSEMBLAR.AssemblyDetailAction" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:textColor">@color/hud_tracking</item>
        <item name="android:textSize">@dimen/assembly_action_text_size</item>
        <item name="android:textStyle">bold</item>
    </style>


    <!--
        Media sizing lives in styles so width-qualified resources can constrain tablet artwork
        without changing the existing phone layouts.
    -->
    <style name="Widget.ASSEMBLAR.ComponentCardMedia" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:adjustViewBounds">true</item>
        <item name="android:background">@color/surface_muted</item>
        <item name="android:maxHeight">180dp</item>
        <item name="android:minHeight">128dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <style name="Widget.ASSEMBLAR.ProjectCardMedia" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">210dp</item>
        <item name="android:background">@color/surface_muted</item>
    </style>

    <style name="Widget.ASSEMBLAR.ProjectDetailMedia" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:adjustViewBounds">true</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:maxHeight">360dp</item>
        <item name="android:minHeight">210dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <style name="Widget.ASSEMBLAR.LearningDetailMedia" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:adjustViewBounds">true</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:maxHeight">360dp</item>
        <item name="android:minHeight">180dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:scaleType">fitCenter</item>
    </style>
</resources>
