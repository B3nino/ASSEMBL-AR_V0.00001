<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas"
    android:orientation="vertical">

    <include
        android:id="@+id/toolbar"
        layout="@layout/view_toolbar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <dev.chyken.assembl_ar.ui.MaxWidthLinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:maxWidth="@dimen/content_max_width"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="10dp"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="28dp">

            <TextView
                style="@style/TextAppearance.ASSEMBLAR.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/choose_project" />

            <TextView
                style="@style/TextAppearance.ASSEMBLAR.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/choose_project_hint" />

            <LinearLayout
                android:id="@+id/neobotProjectCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_card"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:orientation="vertical"
                android:padding="18dp">

                <FrameLayout
                    android:id="@+id/projectCardMedia"
                    style="@style/Widget.ASSEMBLAR.ProjectCardMedia">

                    <ImageView
                        android:id="@+id/projectImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/neobot_project"
                        android:padding="10dp"
                        android:scaleType="fitCenter" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|start"
                        android:layout_margin="12dp"
                        android:background="@drawable/bg_pill"
                        android:text="@string/offline_ready"
                        android:textColor="@color/primary_dark"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/projectCardBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/neobot_project"
                        android:textColor="@color/ink"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="@string/assembly_wiring"
                        android:textColor="@color/primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:text="@string/project_summary"
                        android:textColor="@color/ink_soft"
                        android:textSize="14sp" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/projectProgress"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginTop="16dp"
                        android:max="100"
                        android:progress="0" />

                    <TextView
                        android:id="@+id/projectProgressLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:textColor="@color/ink_soft"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </dev.chyken.assembl_ar.ui.MaxWidthLinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include layout="@layout/view_primary_navigation" />
</LinearLayout>
