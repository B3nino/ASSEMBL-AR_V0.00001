<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas"
    android:orientation="vertical">

    <include layout="@layout/view_toolbar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <dev.chyken.assembl_ar.ui.MaxWidthLinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:maxWidth="@dimen/reading_max_width"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="8dp"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="28dp">

            <ImageView
                android:id="@+id/moduleImage"
                style="@style/Widget.ASSEMBLAR.LearningDetailMedia"
                android:contentDescription="@string/manual_reference"
                />

            <TextView
                android:id="@+id/moduleType"
                style="@style/TextAppearance.ASSEMBLAR.Eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp" />

            <TextView
                android:id="@+id/moduleTitle"
                style="@style/TextAppearance.ASSEMBLAR.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp" />

            <TextView
                android:id="@+id/moduleDescription"
                style="@style/TextAppearance.ASSEMBLAR.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <LinearLayout
                android:id="@+id/learningStepsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical" />
        </dev.chyken.assembl_ar.ui.MaxWidthLinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
