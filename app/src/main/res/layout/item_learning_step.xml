<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card"
    android:elevation="1dp"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/learningStepNumber"
        style="@style/TextAppearance.ASSEMBLAR.Eyebrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/learningStepTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/ink"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/learningStepBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="3dp"
        android:textColor="@color/ink_soft"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/learningCodeBlock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@color/ink"
        android:fontFamily="monospace"
        android:padding="14dp"
        android:textColor="@color/surface"
        android:textIsSelectable="true"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/learningWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_warning"
        android:padding="12dp"
        android:textColor="@color/ink"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/learningPageLink"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:textColor="@color/primary"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
