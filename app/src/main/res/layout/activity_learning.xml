<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas"
    android:orientation="vertical">

    <include layout="@layout/view_toolbar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <dev.chyken.assembl_ar.ui.MaxWidthLinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:maxWidth="@dimen/content_max_width"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="8dp"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="28dp">

            <TextView
                style="@style/TextAppearance.ASSEMBLAR.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/learning_title" />

            <TextView
                style="@style/TextAppearance.ASSEMBLAR.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/learning_hint" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:boxBackgroundColor="@color/surface"
                app:boxCornerRadiusBottomEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusTopStart="14dp"
                app:endIconMode="clear_text">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/learningSearchInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/learning_search_hint"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="@color/ink"
                    android:textColorHint="@color/ink_soft" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:id="@+id/curriculumSequenceCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_warning"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/curriculum_sequence"
                    android:textColor="@color/ink"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/curriculum_sequence_body"
                    android:textColor="@color/ink_soft"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/modulesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/learningEmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:accessibilityLiveRegion="polite"
                android:background="@drawable/bg_card"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="28dp"
                android:paddingTop="36dp"
                android:paddingEnd="28dp"
                android:paddingBottom="36dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_pill"
                    android:contentDescription="@null"
                    android:padding="12dp"
                    android:src="@drawable/ic_book"
                    app:tint="@color/ink_soft" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:text="@string/learning_empty_title"
                    android:textColor="@color/ink"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/learning_empty_body"
                    android:textColor="@color/ink_soft"
                    android:textSize="14sp" />
            </LinearLayout>
        </dev.chyken.assembl_ar.ui.MaxWidthLinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include layout="@layout/view_primary_navigation" />
</LinearLayout>
