<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/assemblyRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:keepScreenOn="true">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/scanning"
        app:implementationMode="compatible"
        app:scaleType="fillCenter" />

    <dev.chyken.assembl_ar.render.ArGlSurfaceView
        android:id="@+id/arGlView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <dev.chyken.assembl_ar.ui.ArHudView
        android:id="@+id/arHudView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/cameraToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@color/camera_toolbar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_circle_dark"
            android:contentDescription="@string/back"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back_white" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/neobot_project"
            android:textColor="@color/white"
            android:textSize="@dimen/assembly_toolbar_text_size"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/livePill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_live_pill"
            android:paddingStart="12dp"
            android:paddingTop="7dp"
            android:paddingEnd="12dp"
            android:paddingBottom="7dp"
            android:text="@string/ar_live_badge"
            android:textColor="@color/hud_tracking"
            android:textSize="@dimen/assembly_badge_text_size"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/devButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_live_pill"
            android:clickable="true"
            android:focusable="true"
            android:minHeight="40dp"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/dev_badge"
            android:textColor="@color/white"
            android:textSize="@dimen/assembly_badge_text_size"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/recognitionBanner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginStart="28dp"
        android:layout_marginTop="82dp"
        android:layout_marginEnd="28dp"
        android:accessibilityLiveRegion="polite"
        android:background="@drawable/bg_live_pill"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="9dp"
        android:paddingEnd="14dp"
        android:paddingBottom="9dp">

        <ProgressBar
            android:id="@+id/recognitionSpinner"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:indeterminateTint="@color/hud_tracking" />

        <TextView
            android:id="@+id/recognitionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:gravity="center_vertical"
            android:lineSpacingExtra="2dp"
            android:maxWidth="285dp"
            android:maxLines="3"
            android:text="@string/scanning"
            android:textColor="@color/white"
            android:textSize="@dimen/assembly_banner_text_size"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/diagnosticsPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center|end"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_camera_panel"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/diagnostics"
            android:textColor="@color/hud_tracking"
            android:textSize="@dimen/assembly_section_text_size"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/diagnosticsText"
            android:layout_width="180dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:fontFamily="monospace"
            android:textColor="@color/white"
            android:textSize="@dimen/assembly_diagnostics_text_size" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/instructionPanel"
        android:layout_width="match_parent"
        android:layout_height="@dimen/assembly_info_panel_height"
        android:layout_gravity="bottom"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_camera_panel"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:id="@+id/instructionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/stepCounter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/hud_tracking"
                    android:textSize="@dimen/assembly_meta_text_size"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/progressLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/white_secondary"
                    android:textSize="@dimen/assembly_progress_text_size" />
            </LinearLayout>

            <TextView
                android:id="@+id/toggleStepInfoButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/hide_step_information"
                android:drawableEnd="@drawable/ic_expand_less"
                android:drawablePadding="5dp"
                android:drawableTint="@color/hud_tracking"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="48dp"
                android:minWidth="104dp"
                android:paddingStart="8dp"
                android:paddingEnd="4dp"
                android:text="@string/hide_step_info"
                android:textColor="@color/hud_tracking"
                android:textSize="@dimen/assembly_action_text_size"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/requiredPartReference"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone">

            <ImageView
                android:id="@+id/requiredPartThumbnail"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@color/surface_muted"
                android:padding="3dp"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/requiredPartName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/requiredPartQuantity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/hud_tracking"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/motorInspectionRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/motorInspectionStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/motor_inspection_initial"
                android:textColor="@color/white_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/relockBaseButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:minWidth="48dp"
                android:paddingHorizontal="8dp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:text="@string/relock_base"
                android:contentDescription="@string/relock_base_description"
                android:textColor="@color/hud_tracking"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/assemblyProgress"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_marginTop="6dp"
            android:max="100"
            app:indicatorColor="@color/hud_tracking"
            app:trackColor="@color/white_track" />

        <ScrollView
            android:id="@+id/stepInfoScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:fadeScrollbars="false"
            android:fillViewport="true"
            android:overScrollMode="ifContentScrolls"
            android:scrollbarSize="3dp"
            android:scrollbarThumbVertical="@drawable/bg_step_info_scrollbar"
            android:scrollbars="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingEnd="8dp"
                android:paddingBottom="6dp">

                <TextView
                    android:id="@+id/stepLeadingContext"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/hud_warning"
                    android:textSize="@dimen/assembly_body_text_size"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/stepTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:textSize="@dimen/assembly_title_text_size"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/phaseResults"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:accessibilityLiveRegion="polite"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/white"
                    android:textSize="@dimen/assembly_material_text_size"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/demoStage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/hud_tracking"
                    android:textSize="@dimen/assembly_meta_text_size"
                    android:textStyle="bold" />

                <dev.chyken.assembl_ar.ui.AssemblyDemoView
                    android:id="@+id/assemblyDemo"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/assembly_demo_height"
                    android:layout_marginTop="8dp"
                    android:importantForAccessibility="yes" />

                <VideoView
                    android:id="@+id/phaseVideo"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/assembly_demo_height"
                    android:layout_marginTop="8dp"
                    android:contentDescription="@string/phase_video_description"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/stepInstruction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/white_secondary"
                    android:textSize="@dimen/assembly_body_text_size" />

                <TextView
                    android:id="@+id/phaseInventory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/white_secondary"
                    android:textSize="@dimen/assembly_material_text_size"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/voiceGuideStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/voice_initializing"
                    android:textColor="@color/white_secondary"
                    android:textSize="@dimen/assembly_caption_text_size" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/assemblyDetailsButton"
                    style="@style/Widget.ASSEMBLAR.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/show_action_details"
                    android:textColor="@color/white"
                    app:strokeColor="@color/camera_control_border" />

                <LinearLayout
                    android:id="@+id/assemblyDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                <TextView
                    android:id="@+id/actionFullInstructions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white_secondary"
                    android:textSize="@dimen/assembly_body_text_size" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/required_materials"
                    android:textAllCaps="true"
                    android:textColor="@color/hud_tracking"
                    android:textSize="@dimen/assembly_section_text_size"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/requiredComponentLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:lineSpacingExtra="1dp"
                    android:textColor="@color/white"
                    android:textSize="@dimen/assembly_material_text_size" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                    android:id="@+id/manualThumbnail"
                        android:layout_width="70dp"
                        android:layout_height="54dp"
                        android:background="@color/surface_muted"
                    android:contentDescription="@string/manual_reference"
                    android:importantForAccessibility="no"
                        android:padding="4dp"
                        android:scaleType="fitCenter" />

                    <TextView
                        android:id="@+id/manualPageLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:textColor="@color/white_tertiary"
                        android:textSize="@dimen/assembly_caption_text_size" />

                    <ImageButton
                        android:id="@+id/viewReferenceButton"
                        android:layout_width="@dimen/touch_target"
                        android:layout_height="@dimen/touch_target"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/view_reference"
                        android:padding="10dp"
                        android:src="@drawable/ic_open"
                        app:tint="@color/white" />
                </LinearLayout>

                <TextView
                    android:id="@+id/manualModeButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:minHeight="@dimen/touch_target"
                    android:text="@string/manual_mode"
                    android:textColor="@color/hud_tracking"
                    android:textSize="@dimen/assembly_action_text_size"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/restartPhaseButton"
                    style="@style/Widget.ASSEMBLAR.AssemblyDetailAction"
                    android:text="@string/phase_restart"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/redoPhaseButton"
                    style="@style/Widget.ASSEMBLAR.AssemblyDetailAction"
                    android:text="@string/phase_redo_earlier"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/workflowModeButton"
                    style="@style/Widget.ASSEMBLAR.AssemblyDetailAction"
                    android:text="@string/workflow_use_cards" />

                <TextView
                    android:id="@+id/shareTrialLogButton"
                    style="@style/Widget.ASSEMBLAR.AssemblyDetailAction"
                    android:text="@string/trial_log_share" />

                <TextView
                    android:id="@+id/buildStampLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:textColor="@color/white_tertiary"
                    android:textIsSelectable="true"
                    android:textSize="@dimen/assembly_caption_text_size" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/redoGuidedStepPanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="8dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/redo_guided_step_hint"
                        android:textColor="@color/white_secondary"
                        android:textSize="@dimen/assembly_body_text_size" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/redoGuidedStepButton"
                        style="@style/Widget.ASSEMBLAR.Button.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/redo_guided_step"
                        android:textColor="@color/white"
                        app:strokeColor="@color/camera_control_border" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:id="@+id/demoControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/replayDemoButton"
                style="@style/Widget.ASSEMBLAR.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="@string/replay_demo"
                android:textColor="@color/white"
                app:strokeColor="@color/camera_control_border" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/voiceGuideButton"
                style="@style/Widget.ASSEMBLAR.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="@string/voice_mute"
                android:textColor="@color/white"
                app:strokeColor="@color/camera_control_border" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/scanAssemblyButton"
            style="@style/Widget.ASSEMBLAR.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/phase_scan_assembly"
            android:visibility="gone"
            app:icon="@drawable/ic_check" />

        <LinearLayout
            android:id="@+id/guidedStepNavigationRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/previousGuidedStepButton"
                style="@style/Widget.ASSEMBLAR.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="@string/previous_guided_step"
                android:textColor="@color/white"
                app:strokeColor="@color/camera_control_border" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/nextGuidedStepButton"
                style="@style/Widget.ASSEMBLAR.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="@string/next_guided_step" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/confirmPlacementButton"
            style="@style/Widget.ASSEMBLAR.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/physical_check"
            android:visibility="gone"
            app:icon="@drawable/ic_check" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/cameraPermissionPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="24dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="22dp"
        android:visibility="gone">

        <TextView
            style="@style/TextAppearance.ASSEMBLAR.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/camera_permission_title"
            android:textSize="22sp" />

        <TextView
            style="@style/TextAppearance.ASSEMBLAR.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/camera_permission_body"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/grantCameraButton"
            style="@style/Widget.ASSEMBLAR.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/grant_camera" />
    </LinearLayout>
</FrameLayout>
