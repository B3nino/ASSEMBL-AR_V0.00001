<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas"
    android:orientation="vertical">

    <include layout="@layout/view_toolbar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <dev.chyken.assembl_ar.ui.MaxWidthLinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:maxWidth="@dimen/reading_max_width"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="8dp"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="110dp">

            <ImageView
                android:id="@+id/manualCoverImage"
                style="@style/Widget.ASSEMBLAR.ProjectDetailMedia"
                android:contentDescription="@string/official_guide"
                />

            <TextView
                style="@style/TextAppearance.ASSEMBLAR.Eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/official_guide" />

            <TextView
                style="@style/TextAppearance.ASSEMBLAR.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="@string/neobot_project" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/project_summary"
                android:textColor="@color/ink_soft"
                android:textSize="15sp" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/detailProgress"
                android:layout_width="match_parent"
                android:layout_height="7dp"
                android:layout_marginTop="18dp"
                android:max="100" />

            <TextView
                android:id="@+id/detailProgressLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:textColor="@color/ink_soft"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_warning"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/required_workspace"
                    android:textColor="@color/ink"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/workspace_body"
                    android:textColor="@color/ink_soft"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                style="@style/TextAppearance.ASSEMBLAR.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/assembly_steps"
                android:textSize="22sp" />

            <LinearLayout
                android:id="@+id/stepsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />

            <TextView
                style="@style/TextAppearance.ASSEMBLAR.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/reference_videos"
                android:textSize="22sp" />

            <TextView
                style="@style/TextAppearance.ASSEMBLAR.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/video_caveat"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/videoAssemblyButton"
                style="@style/Widget.ASSEMBLAR.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/video_assembly" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/videoWiringButton"
                style="@style/Widget.ASSEMBLAR.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/video_wiring" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/videoCombinedButton"
                style="@style/Widget.ASSEMBLAR.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/video_combined" />
        </dev.chyken.assembl_ar.ui.MaxWidthLinearLayout>
    </androidx.core.widget.NestedScrollView>

    <dev.chyken.assembl_ar.ui.MaxWidthLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:maxWidth="@dimen/reading_max_width"
        android:background="@color/surface"
        android:elevation="10dp"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="14dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/startProjectButton"
            style="@style/Widget.ASSEMBLAR.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/begin_assembly"
            app:icon="@drawable/ic_camera" />

        <TextView
            android:id="@+id/restartProjectButton"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:gravity="center"
            android:text="@string/restart_assembly"
            android:textColor="@color/danger"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </dev.chyken.assembl_ar.ui.MaxWidthLinearLayout>
</LinearLayout>
