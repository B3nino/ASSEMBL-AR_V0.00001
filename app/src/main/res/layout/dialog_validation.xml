<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/validationScroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/validationEyebrow"
            style="@style/TextAppearance.ASSEMBLAR.Eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/validation_ready" />

        <TextView
            android:id="@+id/validationTitle"
            style="@style/TextAppearance.ASSEMBLAR.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp" />

        <TextView
            android:id="@+id/validationBody"
            style="@style/TextAppearance.ASSEMBLAR.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp" />

        <CheckBox
            android:id="@+id/validationCheckbox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:buttonTint="@color/primary"
            android:text="@string/validation_checkbox"
            android:textColor="@color/ink"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/confirmNextButton"
            style="@style/Widget.ASSEMBLAR.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:enabled="false"
            android:text="@string/confirm_next" />
    </LinearLayout>
</ScrollView>
