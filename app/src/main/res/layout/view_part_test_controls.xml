<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/partTestControls" android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:clipToPadding="false" android:background="@color/canvas">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Recognition workspace" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/ink" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/part_test_instructions" android:textColor="@color/ink_soft" android:textSize="12sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="8dp">
            <com.google.android.material.button.MaterialButton android:id="@+id/partTestPreviousButton" android:layout_width="48dp" android:layout_height="52dp" android:padding="0dp" android:minWidth="0dp" android:text="‹" android:textSize="22sp" android:contentDescription="@string/part_test_previous" />
            <com.google.android.material.button.MaterialButton android:id="@+id/partTestSelectButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="52dp" android:maxLines="3" android:textSize="13sp" android:layout_marginHorizontal="4dp" style="@style/Widget.ASSEMBLAR.Button.Secondary" />
            <com.google.android.material.button.MaterialButton android:id="@+id/partTestNextButton" android:layout_width="48dp" android:layout_height="52dp" android:padding="0dp" android:minWidth="0dp" android:text="›" android:textSize="22sp" android:contentDescription="@string/part_test_next" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/partTestStartButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/part_test_start" />
        <TextView android:id="@+id/partTestReferenceStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="8dp" android:textSize="12sp" android:textColor="@color/ink_soft" />
        <TextView android:id="@+id/partTestLiveMetrics" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:fontFamily="monospace" android:textColor="@color/ink" />
        <TextView android:id="@+id/partTestTotals" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="8dp" android:textSize="13sp" android:textColor="@color/ink" />
        <com.google.android.material.button.MaterialButton android:id="@+id/partTestBenchmarkButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Benchmark / Settings" />
        <com.google.android.material.button.MaterialButton android:id="@+id/partTestResultsButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/part_test_results" style="@style/Widget.ASSEMBLAR.Button.Secondary" />
        <com.google.android.material.button.MaterialButton android:id="@+id/partTestExportButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Download diagnostic logs" style="@style/Widget.ASSEMBLAR.Button.Secondary" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/partTestCaptureButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/part_test_capture" android:enabled="false" style="@style/Widget.ASSEMBLAR.Button.Secondary" />
            <com.google.android.material.button.MaterialButton android:id="@+id/partTestReplayButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:text="@string/part_test_replay" style="@style/Widget.ASSEMBLAR.Button.Secondary" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/partTestResetButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/part_test_reset" style="@style/Widget.ASSEMBLAR.Button.Secondary" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
